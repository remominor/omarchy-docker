# Pick ONE NVIDIA GPU. Find UUIDs with:
#   nvidia-smi --query-gpu=index,name,uuid,pci.bus_id --format=csv
NVIDIA_VISIBLE_DEVICES=GPU-REPLACE-ME

# CachyOS development Compose persistence. Unraid paths are configured in the
# XML template instead.
APPDATA_PATH=./appdata/omarchy-docker
# headless, bridge, or seat9 (build-and-start.sh default: bridge)
OMARCHY_TEMPLATE=bridge

# Omarchy 4 stable is the safe default. "edge" is supported for testing.
OMARCHY_CHANNEL=stable

# core = Omarchy shell + practical desktop/streaming essentials (recommended first)
# full = almost all packages from Omarchy's current ISO base list; much larger
OMARCHY_PROFILE=core

# Virtual monitor
OMARCHY_OUTPUT_NAME=OMARCHY
OMARCHY_RESOLUTION=2560x1440
OMARCHY_REFRESH=60
OMARCHY_SCALE=1

# Applied only to the Sunshine process, not Hyprland or the host session.
SUNSHINE_SEAT=seat9

# Comma-separated trusted browser origins, including protocol and port.
# Example: https://10.50.0.51:50990
SUNSHINE_CSRF_ALLOWED_ORIGINS=
SUNSHINE_NAME=Omarchy

# Optional. Example: /dev/dri/card1
# Leave blank initially. Set this only if Hyprland chooses the wrong GPU.
AQ_DRM_DEVICES=
