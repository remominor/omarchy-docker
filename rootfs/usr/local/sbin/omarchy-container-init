#!/usr/bin/bash
set -euo pipefail

uid=1000
gid=1000
home=/home/omarchy
seed=/opt/omarchy-home-seed

# Device group IDs come from the host and may not match Arch's named groups.
# Create matching supplementary groups before the user manager starts.
for device in /dev/uinput /dev/input/event* /dev/dri/*; do
  [[ -c "$device" ]] || continue
  device_gid="$(stat -c '%g' "$device")"
  [[ "$device_gid" != 0 ]] || continue
  device_group="$(getent group "$device_gid" | cut -d: -f1 || true)"
  if [[ -z "$device_group" ]]; then
    device_group="omarchy-device-${device_gid}"
    getent group "$device_group" >/dev/null || groupadd --gid "$device_gid" "$device_group"
  fi
  usermod -aG "$device_group" omarchy
done

mkdir -p "$home" /config /config/ssh /run/user "$home/.config"
chmod 0700 /config/ssh
chown root:root /config/ssh

# Keep SSH host identity across container recreation. The package and config
# remain image-owned, while generated host keys live with persistent /config.
for key in ssh_host_rsa_key ssh_host_ecdsa_key ssh_host_ed25519_key; do
  if [[ -e "/config/ssh/$key" || -L "/config/ssh/$key" ]]; then
    ln -sfn "/config/ssh/$key" "/etc/ssh/$key"
  elif [[ -e "/etc/ssh/$key" ]]; then
    mv "/etc/ssh/$key" "/config/ssh/$key"
    ln -s "/config/ssh/$key" "/etc/ssh/$key"
  fi
done
chown "$uid:$gid" "$home" /config

# A bind-mounted empty appdata directory hides the image's original home.
# Seed it once, without overwriting later user changes.
if [[ ! -e "$home/.omarchy-container-seeded" ]]; then
  cp -a "$seed"/. "$home"/
  touch "$home/.omarchy-container-seeded"
fi
chown -R "$uid:$gid" "$home" /config
chown -R root:root /config/ssh
chmod 0700 /config/ssh

# Persist the user's explicit SSH setup across container recreation. The
# Omarchy setup command enables sshd in /etc, which is image/container state;
# an authorized key in the persistent home is the opt-in signal we can safely
# carry forward.
if [[ -s "$home/.ssh/authorized_keys" ]]; then
  touch /config/ssh/enabled
fi
if [[ -e /config/ssh/enabled ]]; then
  systemctl enable sshd.service >/dev/null 2>&1 || true
fi

# Flatpak's bubblewrap sandbox needs a private proc mount. Docker normally
# supplies /proc already, but some runtimes expose a restricted proc mount that
# causes bwrap to fail with "Can't mount proc ... Operation not permitted".
# Refresh it when the runtime permits; leaving the runtime mount in place is
# safe when remounting is unavailable (for example under an LXC wrapper).
mount -t proc proc /proc 2>/dev/null || true

# The seat9 template mirrors Sunshine's virtual event nodes into the private
# device namespace. Headless also runs this discovery shim because some hosts
# (notably Unraid with a private /run tmpfs) do not propagate udev events for
# container-created virtual devices. It never reads or grabs host input.
input_mode="${OMARCHY_INPUT_MODE:-headless}"
case "$input_mode" in
  headless|seat9) /usr/local/bin/omarchy-sync-input-nodes & ;;
  bridge) ;;
  *) echo "ERROR: unsupported OMARCHY_INPUT_MODE=$input_mode" >&2; exit 2 ;;
esac

# Persist Docker-provided settings for both the system manager and user manager.
cat > /etc/omarchy-container.env <<EOF
OMARCHY_PATH=/usr/share/omarchy
OMARCHY_OUTPUT_NAME=${OMARCHY_OUTPUT_NAME:-OMARCHY}
OMARCHY_RESOLUTION=${OMARCHY_RESOLUTION:-2560x1440}
OMARCHY_REFRESH=${OMARCHY_REFRESH:-60}
OMARCHY_SCALE=${OMARCHY_SCALE:-1}
OMARCHY_INPUT_MODE=${OMARCHY_INPUT_MODE:-headless}
SUNSHINE_PORT=${SUNSHINE_PORT:-47989}
SUNSHINE_NAME=${SUNSHINE_NAME:-Omarchy}
SUNSHINE_SEAT=${SUNSHINE_SEAT:-seat9}
SUNSHINE_CSRF_ALLOWED_ORIGINS=${SUNSHINE_CSRF_ALLOWED_ORIGINS:-}
NVIDIA_VISIBLE_DEVICES=${NVIDIA_VISIBLE_DEVICES:-all}
NVIDIA_DRIVER_CAPABILITIES=${NVIDIA_DRIVER_CAPABILITIES:-all}
AQ_DRM_DEVICES=${AQ_DRM_DEVICES:-}
EOF
chmod 0644 /etc/omarchy-container.env

# Create an initial Sunshine config only once. Afterwards it is user-owned and
# can be edited in Sunshine's web UI without being regenerated on restart.
if [[ ! -f /config/sunshine.conf ]]; then
  cat > /config/sunshine.conf <<EOF
sunshine_name = ${SUNSHINE_NAME:-Omarchy}
capture = wlr
encoder = nvenc
keyboard = enabled
mouse = enabled
controller = enabled
output_name = ${OMARCHY_OUTPUT_NAME:-OMARCHY}
port = ${SUNSHINE_PORT:-47989}
origin_web_ui_allowed = lan
address_family = ipv4
upnp = disabled
EOF
fi

# An explicit environment value takes precedence over the persisted setting,
# while leaving the file untouched when the variable is unset.
if [[ -n "${SUNSHINE_CSRF_ALLOWED_ORIGINS:-}" ]]; then
  sed -i '/^csrf_allowed_origins[[:space:]]*=/d' /config/sunshine.conf
  printf 'csrf_allowed_origins = %s\n' "$SUNSHINE_CSRF_ALLOWED_ORIGINS" >> /config/sunshine.conf
fi

# Keep explicit deployment settings effective even when /config is persisted.
if [[ -n "${SUNSHINE_PORT:-}" ]]; then
  sed -i '/^port[[:space:]]*=/d' /config/sunshine.conf
  printf 'port = %s\n' "$SUNSHINE_PORT" >> /config/sunshine.conf
fi
if [[ -n "${SUNSHINE_NAME:-}" ]]; then
  sed -i '/^sunshine_name[[:space:]]*=/d' /config/sunshine.conf
  printf 'sunshine_name = %s\n' "$SUNSHINE_NAME" >> /config/sunshine.conf
fi
if [[ -n "${OMARCHY_OUTPUT_NAME:-}" ]]; then
  sed -i '/^output_name[[:space:]]*=/d' /config/sunshine.conf
  printf 'output_name = %s\n' "$OMARCHY_OUTPUT_NAME" >> /config/sunshine.conf
fi

if [[ ! -f /config/apps.json ]]; then
  cat > /config/apps.json <<'EOF'
{
  "env": {},
  "apps": [
    {
      "name": "Omarchy Desktop",
      "detached": [],
      "prep-cmd": [],
      "exclude-global-prep-cmd": "false",
      "auto-detach": "true"
    }
  ]
}
EOF
fi
chown -R "$uid:$gid" /config
chown -R root:root /config/ssh
chmod 0700 /config/ssh

# systemd complains if this is stale or absent in some container runtimes.
[[ -s /etc/machine-id ]] || systemd-machine-id-setup

exec "$@"
