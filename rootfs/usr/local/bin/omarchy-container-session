#!/usr/bin/bash
set -euo pipefail

source /etc/omarchy-container.env

export HOME=/home/omarchy
export USER=omarchy
export LOGNAME=omarchy
export XDG_RUNTIME_DIR=/run/user/1000
export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland
export XDG_SEAT=seat0
export XDG_SESSION_ID=container
export XDG_VTNR=0
export OMARCHY_PATH=/usr/share/omarchy
export LIBSEAT_BACKEND=seatd
export SEATD_SOCK=/run/seatd.sock
# Sunshine creates its virtual keyboard/mouse after a Moonlight client
# connects. Keep libinput active in the headless compositor and allow the
# initial scan to be empty so those devices can be picked up on hotplug.
export WLR_BACKENDS="${WLR_BACKENDS:-headless,libinput}"
export WLR_LIBINPUT_NO_DEVICES="${WLR_LIBINPUT_NO_DEVICES:-1}"

# Load the container monitor policy after the user's Omarchy modules. This is
# an additive include in the persistent user config, so Hyprland reapplies it
# on display-settings reload without requiring appdata cleanup.
hypr_config="$HOME/.config/hypr/hyprland.lua"
if [[ -f "$hypr_config" ]] && ! grep -Fq 'omarchy-container.hypr.container' "$hypr_config"; then
  printf '\nrequire("omarchy-container.hypr.container")\n' >>"$hypr_config"
fi

# NVIDIA/Wayland defaults. Do not force vendor-specific GL variables unless the
# NVIDIA runtime has actually injected the driver.
if [[ -e /dev/nvidiactl ]]; then
  export GBM_BACKEND=nvidia-drm
  export __GLX_VENDOR_LIBRARY_NAME=nvidia
fi

# Do not export an empty AQ_DRM_DEVICES: Aquamarine treats an explicitly-set
# device list differently from automatic selection.
if [[ -z "${AQ_DRM_DEVICES:-}" ]]; then
  unset AQ_DRM_DEVICES || true
fi

mkdir -p "$HOME/.local/state/omarchy-container"

echo "[$(date -Is)] starting UWSM/Hyprland" \
  >> "$HOME/.local/state/omarchy-container/session.log"

# UWSM provides the user-systemd environment Omarchy 4 expects. Hyprland 0.56+
# has a mandatory headless Aquamarine backend and optional DRM backend.
exec uwsm start -F -eD Hyprland -N "Omarchy Container" \
  -C "Headless Omarchy desktop on Unraid" -- /usr/sbin/start-hyprland
