#!/usr/bin/bash
set +e

source /etc/omarchy-container.env 2>/dev/null || true

export HOME=/home/omarchy
export XDG_RUNTIME_DIR=/run/user/1000
export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"

user_env=(
  XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR"
  DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS"
)
mapfile -t compositor_env < <(
  runuser -u omarchy -- env "${user_env[@]}" systemctl --user show-environment 2>/dev/null |
    grep -E '^(HYPRLAND_INSTANCE_SIGNATURE|WAYLAND_DISPLAY|XDG_CURRENT_DESKTOP|XDG_SESSION_TYPE)='
)

echo "=== CONTAINER ==="
cat /etc/os-release 2>/dev/null | head
echo
systemctl is-system-running 2>/dev/null
echo

echo "=== NVIDIA ==="
nvidia-smi --query-gpu=index,name,uuid,pci.bus_id,driver_version \
  --format=csv,noheader 2>&1
echo
ls -l /dev/nvidia* /dev/dri/* 2>/dev/null
echo

echo "=== EGL / VULKAN ==="
eglinfo -B 2>&1 | sed -n '1,80p'
echo
vulkaninfo --summary 2>&1 | sed -n '1,100p'
echo

echo "=== USER SYSTEMD ==="
systemctl status user@1000.service --no-pager 2>&1 | sed -n '1,80p'
echo
runuser -u omarchy -- env "${user_env[@]}" \
  systemctl --user --no-pager --full status omarchy-desktop.service omarchy-sunshine.service 2>&1
echo

echo "=== HYPRLAND ==="
runuser -u omarchy -- env "${user_env[@]}" "${compositor_env[@]}" \
  hyprctl version 2>&1
runuser -u omarchy -- env "${user_env[@]}" "${compositor_env[@]}" \
  hyprctl monitors all 2>&1
echo

echo "=== AUDIO ==="
runuser -u omarchy -- env "${user_env[@]}" \
  pactl info 2>&1 | sed -n '1,80p'
runuser -u omarchy -- env "${user_env[@]}" \
  pactl list short sinks 2>&1
echo
tail -60 /home/omarchy/.local/state/omarchy-container/audio-init.log 2>/dev/null
echo

echo "=== SUNSHINE ==="
ss -lntup 2>&1 | grep -E 'sunshine|479|489|480|490' || true
echo
tail -80 /home/omarchy/.local/state/omarchy-container/headless-init.log 2>/dev/null
echo

echo "=== INPUT BRIDGE ==="
systemctl --no-pager --full status omarchy-input-bridge.service 2>&1 | sed -n '1,100p'
echo
ps -C omarchy-input-bridge -o pid,user,uid,etime,args 2>/dev/null
echo
findmnt -no TARGET,SOURCE,OPTIONS /host/input 2>&1 || true
test -d /dev/input && echo "WARNING: /dev/input exists" || echo "/dev/input absent"
findmnt -no TARGET /run/udev 2>/dev/null && echo "WARNING: /run/udev mounted" || true
test -f /run/omarchy-input-bridge/ready && echo "bridge readiness: published" || echo "bridge readiness: absent"
printf 'Compositor environment: %s\n' "${compositor_env[*]:-(unavailable)}"
grep -E 'ready|grabbed|released|ERROR' \
  <(journalctl --no-pager -u omarchy-input-bridge.service -n 120) 2>/dev/null || true
echo
journalctl --no-pager -n 120 -u omarchy-user.service
