#!/usr/bin/bash
set -euo pipefail

source /etc/omarchy-container.env

export HOME=/home/omarchy
export XDG_RUNTIME_DIR=/run/user/1000
export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"

log="$HOME/.local/state/omarchy-container/headless-init.log"
mkdir -p "$(dirname "$log")"
exec >>"$log" 2>&1

echo "[$(date -Is)] headless init starting"

refresh_compositor_env() {
  while IFS='=' read -r name value; do
    case "$name" in
      HYPRLAND_INSTANCE_SIGNATURE|WAYLAND_DISPLAY|XDG_CURRENT_DESKTOP|XDG_SESSION_TYPE|XDG_SESSION_DESKTOP) \
        export "$name=$value" \
        ;;
    esac
  done < <(systemctl --user show-environment)
}

# Hyprland may already have a headless output when there is no usable DRM seat.
# If not, create a stable, explicitly named one.
for _ in {1..600}; do
  refresh_compositor_env
  if hyprctl -j version >/dev/null 2>&1; then
    break
  fi
  sleep 0.1
done

if ! hyprctl -j version >/dev/null 2>&1; then
  echo "ERROR: hyprctl never became available"
  exit 1
fi

if ! hyprctl -j monitors all 2>/dev/null | jq -e \
     --arg n "$OMARCHY_OUTPUT_NAME" '.[] | select(.name == $n)' >/dev/null; then
  echo "Creating headless output: $OMARCHY_OUTPUT_NAME"
  hyprctl output create headless "$OMARCHY_OUTPUT_NAME"
fi

output_scale="${OMARCHY_SCALE}"
monitors_config="$HOME/.config/hypr/monitors.lua"
if [[ -f "$monitors_config" ]]; then
  saved_scale="$(sed -nE 's/.*omarchy_monitor_scale[[:space:]]*=[[:space:]]*([0-9]+([.][0-9]+)?).*/\1/p' "$monitors_config" | head -n1)"
  [[ -n "$saved_scale" ]] && output_scale="$saved_scale"
fi
echo "Configuring ${OMARCHY_OUTPUT_NAME}: ${OMARCHY_RESOLUTION}@${OMARCHY_REFRESH}, scale ${output_scale}"
hyprctl eval "hl.monitor({ output = \"${OMARCHY_OUTPUT_NAME}\", mode = \"${OMARCHY_RESOLUTION}@${OMARCHY_REFRESH}\", position = \"0x0\", scale = ${output_scale} })"

# Moonlight should see only the stable virtual output. Keep /dev/dri available
# for GPU rendering, but disable any physical connectors that Aquamarine found.
while IFS= read -r monitor; do
  [[ -z "$monitor" ]] && continue
  echo "Disabling physical output: $monitor"
  hyprctl eval "hl.monitor({ output = \"${monitor}\", disabled = true })" || true
done < <(hyprctl -j monitors all | jq -r --arg virtual "$OMARCHY_OUTPUT_NAME" \
  '.[] | select(.name != $virtual) | .name')

# Keep the workspace on the virtual output.
hyprctl eval "hl.dispatch(hl.dsp.focus({ monitor = \"${OMARCHY_OUTPUT_NAME}\" }))" || true

# Refresh user-manager environment so Sunshine sees this Wayland socket.
systemctl --user import-environment \
  WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP \
  XDG_SESSION_TYPE XDG_SESSION_DESKTOP OMARCHY_PATH || true
dbus-update-activation-environment --systemd \
  WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP \
  XDG_SESSION_TYPE XDG_SESSION_DESKTOP OMARCHY_PATH || true

case "${OMARCHY_INPUT_MODE:-headless}" in
  bridge)
    echo "Starting input bridge; Sunshine waits for bridge readiness"
    systemctl restart omarchy-input-bridge.service
    ;;
  headless|seat9)
    echo "Starting Sunshine"
    systemctl --user restart omarchy-sunshine.service
    ;;
  *)
    echo "ERROR: unsupported OMARCHY_INPUT_MODE=${OMARCHY_INPUT_MODE}" >&2
    exit 2
    ;;
esac

echo "Current monitors:"
hyprctl monitors all || true
echo "[$(date -Is)] headless init complete"
